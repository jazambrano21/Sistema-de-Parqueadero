# RabbitMQ Configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_QUEUE=audit-queue
RABBITMQ_EXCHANGE=audit-exchange
RABBITMQ_ROUTING_KEY=audit.*

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=audit_db

# Throttler Configuration (Rate Limiting)
THROTTLE_TTL=60000
THROTTLE_LIMIT=10

# Server Configuration
PORT=3000
