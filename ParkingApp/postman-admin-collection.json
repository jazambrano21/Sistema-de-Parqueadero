    {
      "name": "9. Espacios - SSE (Server-Sent Events)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "text/event-stream"
          }
        ],
        "url": {
          "raw": "http://localhost:8000/api/espacios/sse?token={{token}}",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8000",
          "path": ["api", "espacios", "sse"],
          "query": [
            {
              "key": "token",
              "value": "{{token}}"
            }
          ]
        },
        "description": "Conexión de streaming para recibir cambios de estado de espacios en tiempo real. El token va por query string porque EventSource no soporta headers personalizados."
      },
      "response": []
    },
