{
  "info": {
    "_postman_id": "parking-admin-collection",
    "name": "Parking Admin - Sistema de Parqueadero",
    "description": "Colección de endpoints para pruebas de administrador del sistema de parqueadero. Incluye autenticación, zonas, espacios, vehículos, tickets y auditoría.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Auth - Login admin",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"1234567890\"\n}"
        },
        "url": {
          "raw": "http://localhost:8000/api/auth/login",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8000",
          "path": ["api", "auth", "login"]
        },
        "description": "Inicia sesión con el usuario admin por defecto. El test script guarda automáticamente el accessToken en la variable de colección 'token'. Las demás requests heredan el auth Bearer automáticamente."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "  const json = pm.response.json();",
              "  pm.collectionVariables.set('token', json.accessToken);",
              "  console.log('Token guardado en variable de colección');",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "2. Auth - Registrar usuario",
