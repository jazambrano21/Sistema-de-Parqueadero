        "body": {
          "mode": "raw",
          "raw": "{\n  \"person\": {\n    \"dni\": \"2222222222\",\n    \"firstName\": \"Juan\",\n    \"lastName\": \"Perez\",\n    \"email\": \"juan.perez@test.com\",\n    \"phone\": \"0999999999\",\n    \"nationality\": \"Ecuatoriana\"\n  },\n  \"username\": \"jperez\",\n  \"password\": \"12345678\"\n}"
        },
        "url": {
          "raw": "http://localhost:8000/api/auth/register",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8000",
          "path": ["api", "auth", "register"]
        },
        "description": "Registra un nuevo usuario y le asigna el rol ADMIN automáticamente."
      },
      "response": []
    },
